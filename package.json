{
  "name": "mypolitics-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "proprietary",
  "main": "index.js",
  "author": "generacja-innowacja",
  "scripts": {
    "prebuild": "yarn i18n:compile",
    "dev": "yarn prebuild && yarn vite",
    "build": "yarn prebuild && npx react-router build",
    "test": "yarn prebuild && vitest",
    "test:coverage": "yarn prebuild && vitest run --coverage",
    "e2e": "playwright test",
    "e2e:local": "playwright test --project=chromium",
    "e2e:ui": "playwright test --ui",
    "lint": "npx @biomejs/biome lint",
    "lint:fix": "npx @biomejs/biome check --write",
    "storybook": "yarn prebuild && storybook dev -p 6006",
    "storybook:build": "yarn prebuild && storybook build",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --typescript",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@gi-org-pl/athena": "^1.2.0",
    "@lingui/react": "^6.10.0",
    "@react-router/fs-routes": "^7.18.4",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "~4.1.13",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.6.2",
    "@chromatic-com/storybook": "4.1.4",
    "@lingui/babel-plugin-lingui-macro": "^6.10.0",
    "@lingui/cli": "^6.10.0",
    "@lingui/vite-plugin": "^6.10.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^7.18.4",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-onboarding": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.11.30",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "playwright": "^1.64.1",
    "react-test-renderer": "^19.3.1",
    "storybook": "10.6.3",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=24.22.1",
    "yarn": ">=1.22"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
